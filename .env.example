# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallback keys from OTHER AI Studio projects (used when the primary
# project hits its daily free-tier quota or runs out of credits).
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...

# Optional overrides
# TRANSCRIBE_MODEL=gemini-3.5-transcribe
# TEXT_MODEL=gemini-3.6-flash   (gemini-2.5-flash is closed to new API keys)
# TEXT_FALLBACK_MODEL=gemini-3.5-flash
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
